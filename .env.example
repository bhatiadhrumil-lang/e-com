# ==============================================================================
# Cloud-Native Order Processing Platform — environment template
# Copy this file to `.env` (root), `backend/.env` and adjust values.
# NEVER commit real .env files.
# ==============================================================================

# --- Database -----------------------------------------------------------------
# Local development (docker-compose in database/)
DATABASE_URL="postgresql://ecom:ecom_secret@localhost:5432/ecom?schema=public"
# Supabase (session-mode pooler, IPv4). Put the real value only in backend/.env
# (never here). If the DB password contains '@', percent-encode it as %40:
# DATABASE_URL="postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD_ENCODED>@aws-0-<REGION>.pooler.supabase.com:5432/postgres?sslmode=require&schema=public"

# --- Backend ------------------------------------------------------------------
PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGIN="http://localhost:5173"
# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="1d"
# Set to "true" only for local seed scripts against a disposable database
SEED_DEMO_DATA="false"

# --- Frontend -----------------------------------------------------------------
# Vite dev server proxies /api to this URL
VITE_API_BASE_URL="/api"
